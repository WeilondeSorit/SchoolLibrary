@model List<SchoolLibrary.Models.Borrowing>
@{
    ViewData["Title"] = "Профиль";
    var role = ViewBag.UserRole as string;
    var name = ViewBag.UserName as string;
    var isLibrarian = role == "Librarian";
    var active = Model.Where(b => !b.IsReturned).ToList();
    var returned = Model.Where(b => b.IsReturned).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/books.css" asp-append-version="true" />
}

<div class="profile-page">
    <aside class="profile-sidebar">
        <div class="profile-avatar">@(string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1).ToUpper())</div>
        <h2 class="profile-name">@name</h2>
        <p class="profile-role">@(isLibrarian ? "Библиотекарь" : "Ученик")</p>
        <a asp-controller="Account" asp-action="Logout" class="btn-logout">Выйти</a>
    </aside>

    <section class="profile-content">
        @if (isLibrarian)
        {
            <h3>Панель библиотекаря</h3>
            <div class="librarian-grid">
                <a asp-controller="Books"      asp-action="Index" class="librarian-card">📚<span>Книги</span></a>
                <a asp-controller="Authors"    asp-action="Index" class="librarian-card">✍️<span>Авторы</span></a>
                <a asp-controller="Students"   asp-action="Index" class="librarian-card">🎓<span>Ученики</span></a>
                <a asp-controller="Borrowings" asp-action="Index" class="librarian-card">📋<span>Выдачи</span></a>
            </div>
        }
        else
        {
            <h3>Мои книги <span class="badge available" style="position:static;">@active.Count</span></h3>

            @if (active.Count == 0)
            {
                <div class="empty-state"><p>У вас пока нет активных выдач.</p></div>
            }
            else
            {
                <div class="borrow-list">
                    @foreach (var b in active)
                    {
                        var bookTitle = b.Book?.Title ?? "—";
                        var authors = b.Book?.Authors is { Count: > 0 }
                            ? string.Join(", ", b.Book.Authors.Select(a => a.FullName))
                            : "—";

                        <div class="borrow-card @(b.IsOverdue ? "overdue" : "")">
                            <div class="borrow-info">
                                <h4>@bookTitle</h4>
                                <p class="borrow-author">@authors</p>
                            </div>
                            <div class="borrow-dates">
                                <div>
                                    <span class="label">Взята</span>
                                    <span class="value">@b.BorrowDate.ToString("dd.MM.yyyy")</span>
                                </div>
                                <div>
                                    <span class="label">Вернуть до</span>
                                    <span class="value @(b.IsOverdue ? "danger" : "")">
                                        @b.DueDate.ToString("dd.MM.yyyy")
                                    </span>
                                </div>
                            </div>
                            <form asp-controller="Books" asp-action="Return" asp-route-id="@b.Id" method="post" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-return">Вернуть</button>
                            </form>
                        </div>
                    }
                </div>
            }

            @if (returned.Count > 0)
            {
                <h3 style="margin-top:32px;">История возвратов</h3>
                <div class="borrow-list">
                    @foreach (var b in returned)
                    {
                        <div class="borrow-card" style="opacity:.65; border-left-color:#9ca3af;">
                            <div class="borrow-info">
                                <h4>@(b.Book?.Title ?? "—")</h4>
                                <p class="borrow-author">@(b.ReturnDate?.ToString("dd.MM.yyyy"))</p>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </section>
</div>