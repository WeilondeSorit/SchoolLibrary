@using Microsoft.AspNetCore.Http
@{
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
    var roleRu = userRole == "Librarian" ? "Библиотекарь" : "Ученик";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Школьная библиотека</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (!string.IsNullOrEmpty(userName))
    {
        <header class="app-header">
            <a asp-controller="Books" asp-action="Index" class="app-logo">📚 Школьная библиотека</a>

            <div class="app-user">
                @if (userRole == "Librarian")
                {
                    <a asp-controller="Authors" asp-action="Index" class="nav-link-app">Авторы</a>
                    <a asp-controller="Students" asp-action="Index" class="nav-link-app">Ученики</a>
                    <a asp-controller="Borrowings" asp-action="Index" class="nav-link-app">Выдачи</a>
                }

                <a asp-controller="Account" asp-action="Profile" class="profile-btn">
                    <span class="avatar">@userName.Substring(0,1).ToUpper()</span>
                    <span class="profile-info">
                        <span class="profile-name">@userName</span>
                        <span class="profile-role">@roleRu</span>
                    </span>
                </a>
            </div>
        </header>
    }

    <main class="app-main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>