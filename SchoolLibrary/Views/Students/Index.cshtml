@model List<SchoolLibrary.Models.Student>
@{
    ViewData["Title"] = "Ученики";
}

<div class="books-page">
    <div class="books-toolbar">
        <div class="toolbar-form">
            <span class="book-title">Всего учеников: @Model.Count</span>
        </div>
        <a asp-controller="Books" asp-action="Index" class="btn-reset">← К книгам</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🎓</div>
            <p>Список учеников пуст</p>
        </div>
    }
    else
    {
        <div class="books-grid">
            @foreach (var student in Model)
            {
                <div class="book-card">
                    <div class="book-cover">
                        <div class="profile-avatar">@student.FullName.Substring(0, 1).ToUpper()</div>
                    </div>

                    <div class="book-body">
                        <h3 class="book-title">@student.FullName</h3>
                        <p class="book-author">Класс: @(student.ClassName ?? "—")</p>
                        <p class="book-meta">@(student.Email ?? "—")</p>
                    </div>

                    <div class="book-actions">
                        <a asp-action="Details" asp-route-id="@student.Id" class="btn-details">Подробнее</a>
                    </div>
                </div>
            }
        </div>
    }
</div>