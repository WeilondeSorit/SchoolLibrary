@{
    ViewData["Title"] = "Страница не найдена";
    Layout = "_LayoutLogin";
}

@section Styles {
    <link rel="stylesheet" href="~/css/notfound.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="nf-page">
    <div class="nf-bg"></div>
    <div class="nf-overlay"></div>

    <div class="nf-content">
        <div class="nf-code">404</div>

        <div class="nf-icon" aria-hidden="true">
 <img src="~/images/logo.png" alt="Логотип библиотеки" class="login-logo" />

        </div>

        <h1 class="nf-title">Страница не найдена</h1>
        <p class="nf-text">
            Похоже, этой страницы нет в нашей библиотеке.<br />
            Возможно, она была удалена, переименована<br />
            или вы ошиблись в адресе.
        </p>

        <div class="nf-actions">
            <a asp-controller="Books" asp-action="Index" class="nf-btn nf-btn-primary">
                К каталогу книг
            </a>
            <a asp-controller="Home" asp-action="Index" class="nf-btn nf-btn-ghost">
                На главную
            </a>
        </div>

        <p class="nf-hint">Код ошибки: 404 — Not Found</p>
    </div>
</div>