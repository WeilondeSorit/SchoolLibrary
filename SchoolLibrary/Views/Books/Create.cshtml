@model SchoolLibrary.ViewModels.BookFormViewModel
@{
    ViewData["Title"] = "Добавить книгу";
    var authors = ViewBag.Authors as List<SchoolLibrary.Models.Author> ?? new();
    var importError = TempData["ImportError"] as string;
    var importSuccess = TempData["ImportSuccess"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
}

<div class="books-page">
    <div class="books-toolbar">
        <div class="toolbar-form">
            <a asp-action="Index" class="btn-reset">← К каталогу</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(importSuccess))
    {
        <div class="import-message success">✅ @importSuccess</div>
    }
    @if (!string.IsNullOrEmpty(importError))
    {
        <div class="import-message error">⚠️ @importError</div>
    }

    <div class="form-page">
        <h1>Добавить книгу</h1>

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="app-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="field-error"></div>

            <div class="form-group">
                <label asp-for="Title"></label>
                <input asp-for="Title" class="form-control" placeholder="Например: Война и мир" />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="AuthorIds"></label>
                @if (authors.Count == 0)
                {
                    <p class="book-meta">Авторов пока нет.</p>
                }
                else
                {
                    <select asp-for="AuthorIds" class="form-control" multiple size="6">
                        @foreach (var a in authors)
                        {
                            <option value="@a.Id">@a.FullName</option>
                        }
                    </select>
                    <p class="book-meta" style="margin-top:6px;">
                        Удерживайте <b>Ctrl</b> (Cmd), чтобы выбрать нескольких авторов.
                    </p>
                }
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Genre"></label>
                    <input asp-for="Genre" class="form-control" />
                    <span asp-validation-for="Genre" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Year"></label>
                    <input asp-for="Year" type="number" class="form-control" />
                    <span asp-validation-for="Year" class="field-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Isbn"></label>
                <input asp-for="Isbn" class="form-control" />
                <span asp-validation-for="Isbn" class="field-error"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="TotalCopies"></label>
                    <input asp-for="TotalCopies" type="number" min="0" class="form-control" />
                    <span asp-validation-for="TotalCopies" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="AvailableCopies"></label>
                    <input asp-for="AvailableCopies" type="number" min="0" class="form-control" />
                    <span asp-validation-for="AvailableCopies" class="field-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="CoverUrl"></label>
                <input asp-for="CoverUrl" class="form-control" placeholder="https://..." />
                <span asp-validation-for="CoverUrl" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageFile"></label>
                <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" />
            </div>

            <div class="form-group">
                <label style="display:flex; align-items:center; gap:8px;">
                    <input asp-for="IsHidden" type="checkbox" />
                    <span>@Html.DisplayNameFor(m => m.IsHidden)</span>
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">Сохранить</button>
                <a asp-action="Index" class="btn-secondary">Отмена</a>
            </div>
        </form>

        <!-- ==================== Импорт из Excel ==================== -->
        <div class="import-block">
            <h2>📥 Импорт книг из Excel</h2>
            <p class="import-hint">
                Загрузите файл <code>.xlsx</code> — все книги из файла добавятся сразу.
                Первая строка — заголовки, данные начинаются со второй строки.
            </p>

            <div class="import-format">
                <p class="import-format-title">Формат файла (колонки слева направо):</p>
                <table class="import-format-table">
                    <thead>
                        <tr>
                            <th>Кол.</th>
                            <th>Поле</th>
                            <th>Обязательно</th>
                            <th>Пример</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>A</td><td>Название</td><td>✅</td><td>Война и мир</td></tr>
                        <tr><td>B</td><td>Жанр</td><td>—</td><td>Роман</td></tr>
                        <tr><td>C</td><td>Год</td><td>—</td><td>1869</td></tr>
                        <tr><td>D</td><td>ISBN</td><td>—</td><td>978-5-04-116000-1</td></tr>
                        <tr><td>E</td><td>Всего экземпляров</td><td>—</td><td>5</td></tr>
                        <tr><td>F</td><td>Доступно сейчас</td><td>—</td><td>3</td></tr>
                        <tr><td>G</td><td>Ссылка на обложку</td><td>—</td><td>https://...</td></tr>
                        <tr><td>H</td><td>Скрыта (да/нет)</td><td>—</td><td>нет</td></tr>
                    </tbody>
                </table>
                <p class="import-note">
                    ⓘ Авторы через Excel не импортируются — их можно проставить после импорта через «Редактировать».
                </p>
            </div>

            <form asp-action="Import" method="post" enctype="multipart/form-data" class="import-form">
                @Html.AntiForgeryToken()
                <input type="file" name="excelFile" accept=".xlsx" class="form-control" required />
                <button type="submit" class="btn-primary">Импортировать</button>
                <a asp-action="DownloadTemplate" class="btn-secondary">📄 Скачать шаблон</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}